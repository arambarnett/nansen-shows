# Nansen API key — https://app.nansen.ai/api (free tier works for facts; a few credits per episode)
NANSEN_API_KEY=
# Monkeygun API key — https://monkeygun.com → Settings → API keys (a new account's free credits cover ~2 episodes)
MONKEYGUN_API_KEY=
# Optional: which chain the token/wallet lives on (robinhood, arc, ethereum, base, solana, bnb, arbitrum, monad, hyperevm)
NANSEN_CHAIN=robinhood
